    {
      "path": "/api/cron/job-summary",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/cleanup-rejected",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/watchdog",
